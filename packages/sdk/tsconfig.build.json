{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    // Resolve the workspace libraries from their build output (see
    // scripts/pack-dist.ts), not their TypeScript source.
    "paths": {
      "@buildinternet/releases-api-types": ["../api-types/dist/api-types.d.ts"],
      "@buildinternet/releases-core/*": ["../core/dist/*.d.ts"]
    }
  },
  "include": ["src"]
}
