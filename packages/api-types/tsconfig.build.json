{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    // Resolve core from its build output, not its TypeScript source, so the
    // workspace copy isn't compiled into this package. Run core's build first.
    "paths": {
      "@buildinternet/releases-core/*": ["../core/dist/*.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts"]
}
